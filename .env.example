
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

TRUST_PROXY=0

# PostgreSQL (Neon / Prisma)
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT Authentication
JWT_ACCESS_SECRET="replace-with-a-secure-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="replace-with-a-secure-random-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Session
SESSION_TTL_SECONDS=604800

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# OTP
OTP_HASH_SECRET="replace-with-a-secure-random-secret"
OTP_REQUEST_USER_LIMIT=3
OTP_REQUEST_IP_LIMIT=10
OTP_VERIFY_IP_LIMIT=20
