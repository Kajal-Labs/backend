{
    "compilerOptions": {
        "strict": true,

        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2023",

        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "isolatedModules": true,

        "sourceMap": true,
        "removeComments": true,

        "outDir": "./dist",
        "types": ["node"],

        "incremental": true,
        "skipLibCheck": true,

        "forceConsistentCasingInFileNames": true
    }
}
